# Copy to worker/.env (worker) — never commit real values.
DATABASE_URL_DIRECT=            # Neon direct (non-pooled) connection string, main branch
DATABASE_URL=                   # Neon pooled connection string (the web app uses this one)
LOCAL_DATABASE_URL=             # optional PGlite stand-in for tests: TEST_DATABASE_URL=$LOCAL_DATABASE_URL
DATABASE_URL_DEMO=              # Neon demo branch (demo_check only)
BRIGHTDATA_API_TOKEN=
BD_DATASET_FB_MARKETPLACE=gd_lvt9iwuh6fbcwmx1a
BD_DATASET_EBAY=gd_ltr9mjt81n0zzdk1fb
BD_UNLOCKER_ZONE=               # Web Unlocker zone name (Craigslist); stage skips when empty
GEMINI_API_KEYS=k1,k2,k3
GEMINI_MODEL_VISION=gemini-3.6-flash,gemini-3.5-flash,gemini-3.8-flash,gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
TRIPO_API_KEYS=
MESHY_API_KEYS=
HF_TOKENS=
HF_SPACE_IMAGE_TO_3D=
