BLOB_READ_WRITE_TOKEN=          # Vercel Blob store token (vercel_blob_rw_...); empty = worker/.localstore (dev only)
AI_GATEWAY_API_KEY=             # Vercel AI Gateway (vck_...): NOT a Blob token; unused by the worker
ELEVENLABS_API_KEY=             # demo_check only
NEON_API_KEY=                   # scripts/branch_demo only
NEON_PROJECT_ID=
SITE_URL=                       # demo_check: https://<your domain>
