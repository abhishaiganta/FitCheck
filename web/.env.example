# Copy to .env.local (never commit real values).
DATABASE_URL=            # Neon pooled, main branch
DATABASE_URL_DEMO=       # Neon pooled, demo branch
DEMO_MODE=0              # 1 = search and item pages read DATABASE_URL_DEMO
GEMINI_API_KEYS=         # key1,key2,key3 (rotation order)
GEMINI_MODEL_FAST=gemini-flash-lite-latest
GEMINI_MODEL_VISION=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001   # must match the worker
EMBED_DIM=768
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_SITE_URL=    # https://<your domain>
ORIGIN_LAT=32.8801
ORIGIN_LNG=-117.2376
ADMIN_TOKEN=             # long random string for /admin
BRIGHTDATA_API_TOKEN=    # only for the agent's verifyStillListed tool
BD_UNLOCKER_ZONE=
SEARCH_ENGINE=direct     # direct (~1 s) | agent (Mastra, several seconds) | keyword
CAR_FIT=0                # 1 turns car-fit badges on (needs the cars table loaded)
AGENT_TIMEOUT_MS=7000

# Starts the 3D worker (GitHub Actions) the moment someone uploads on /sell.
# Fine-grained GitHub token, this repo only, permission "Actions: read and write".
GITHUB_DISPATCH_TOKEN=
